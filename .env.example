PORT=3000
MONGODB_URI=mongodb://localhost:27017/support_summary

# Ключ и модель вводятся на странице «Подключение ИИ», а не здесь.
# Строки ниже можно оставить пустыми: приложение их не читает.
AI_PROVIDER=

# OpenAI. Ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Примеры моделей: gpt-6-luna, gpt-6.1-sol, gpt-6-astra
OPENAI_MODEL=

# Claude. Ключ: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Примеры моделей: claude-haiku-5-5, claude-sonnet-5-5, claude-opus-5-5
ANTHROPIC_MODEL=

# OpenRouter. Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Имя модели с автором. Примеры: openai/gpt-6-luna, anthropic/claude-sonnet-5-5
OPENROUTER_MODEL=

AI_REQUESTS_PER_HOUR=20
AI_REQUESTS_PER_DAY=300
DEMO_PASSWORD=
# Длинная случайная строка. Ею закрывается ключ ИИ в базе.
# Это не ключ службы. Придумайте её один раз и никому не показывайте.
SETTINGS_SECRET=
TRUST_PROXY=false
APP_PORT=8080
