PORT=3000
MONGODB_URI=mongodb://localhost:27017/support_summary

# Провайдер, ключ и модель ИИ задаются на странице «Подключение ИИ», не в этом файле.

AI_REQUESTS_PER_HOUR=20
AI_REQUESTS_PER_DAY=300
DEMO_PASSWORD=
# Длинная случайная строка. Ею шифруется ключ ИИ, сохранённый на странице «Подключение ИИ».
# Это не ключ службы. Придумайте её один раз и никому не показывайте.
SETTINGS_SECRET=
TRUST_PROXY=false
APP_PORT=8080

# Только для своего сервера (VPS), см. docs/deploy.md. На своём компьютере не трогайте.
# На сервере уберите знак # в начале двух строк ниже.
# SITE_ADDRESS — домен сайта, например summary.example.ru, или :80, если домена нет.
# SITE_ADDRESS=:80
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.vps.yml
